JWT_SECRET = "your_jwt_secret_key_here_at_least_32_chars_long"
ADMIN_EMAIL = "saidumuhammed664@gmail.com"
PORT = "5000"
PRIVATE_OBJECT_DIR = "ARAPOINT_FILES_STORAGE"

