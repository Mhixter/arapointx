modules = ["nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_object_storage:2.0.0", "javascript_openai_ai_integrations:2.0.0"]

[nix]
channel = "stable-25_05"
packages = ["chromium", "poppler"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "RPA Worker"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Arapoint Video Ad"

[[workflows.workflow]]
name = "Server Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Arapoint && NODE_ENV=development node_modules/.bin/tsx server/index.ts"
waitForPort = 5000

[[workflows.workflow]]
name = "RPA Worker"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Arapoint && NODE_ENV=development node_modules/.bin/tsx server/rpa-worker.ts"

[[workflows.workflow]]
name = "Arapoint Video Ad"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"
isCanvasWorkflow = true

[[ports]]
localPort = 3001
externalPort = 4200

[[ports]]
localPort = 3002
externalPort = 5173

[[ports]]
localPort = 4500
externalPort = 3000

[[ports]]
localPort = 4501
externalPort = 3001

[[ports]]
localPort = 4502
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3003

