modules = ["nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_object_storage:2.0.0", "javascript_openai_ai_integrations:2.0.0"]

[nix]
channel = "stable-25_05"
packages = ["chromium", "poppler"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "RPA Worker"

[[workflows.workflow]]
name = "Server Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Arapoint && NODE_ENV=development node_modules/.bin/tsx server/index.ts"
waitForPort = 5000

[[workflows.workflow]]
name = "RPA Worker"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Arapoint && NODE_ENV=development node_modules/.bin/tsx server/rpa-worker.ts"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]

[userenv]

[userenv.shared]
PUPPETEER_EXECUTABLE_PATH = "/nix/store/qa9cnw4v5xkxyip6mb9kxqfq1z4x2dx1-chromium-138.0.7204.100/bin/chromium"
TECHHUB_API_KEY = "                             dv_618746d812664c084aedc36468524a89_1769663857                        "
NODE_ENV = "development"
RPA_MAX_CONCURRENT_JOBS = "5"
ADMIN_NAME = "Admin User"
